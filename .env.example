# Copy to .env.local and fill in. Only the provider you use needs a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Organisers' dataset endpoint: paste the DEV GET link from the task PDF (page 3).
# The group_id parameter is set by the app, so the link can be pasted as is. Do not commit it.
ORGANISER_API_URL=

# Evaluation model: leave empty to use config/models.json (benchmark winner, or a placeholder until then).
# Setting both overrides the registry default. The UI settings override both.
CQA_PROVIDER=
CQA_MODEL=
CQA_SAMPLES=
CQA_CONCURRENCY=5
# Local model endpoint (Ollama)
OLLAMA_URL=http://localhost:11434

# Leave empty for same-origin API. Set for a static UI bundle talking to a separately hosted API.
NEXT_PUBLIC_API_BASE=
# Team name written to results.json (npm run results and the export button)
CQA_TEAM_NAME=
