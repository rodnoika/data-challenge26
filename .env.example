# Copy to .env.local and fill in. Only the provider you use needs a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Organisers' dataset endpoint: paste the DEV GET link from the task PDF (page 3).
# The group_id parameter is set by the app, so the link can be pasted as is. Do not commit it.
ORGANISER_API_URL=

# Evaluation model: leave empty to use config/models.json (benchmark winner, or a placeholder until then).
# Setting both overrides the registry default. The UI settings override both.
CQA_PROVIDER=
CQA_MODEL=
CQA_SAMPLES=
CQA_CONCURRENCY=5
# Local model endpoint (Ollama)
OLLAMA_URL=http://localhost:11434
# Context window per request (default 16384; raise to 32768 for long call transcripts)
OLLAMA_NUM_CTX=
# true/false forces the reasoning pass on or off; empty = the model's default
OLLAMA_THINK=
# Output token cap per reply (default 4096 with thinking off, 8192 otherwise); stops runaway loops
OLLAMA_NUM_PREDICT=

# Leave empty for same-origin API. Set for a static UI bundle talking to a separately hosted API.
NEXT_PUBLIC_API_BASE=
# Team name written to results.json (npm run results and the export button)
CQA_TEAM_NAME=
# Extra hosts the "Добавить по ссылке" form may fetch from, comma separated (the organisers' API host is always allowed)
CQA_FETCH_ALLOWED_HOSTS=
